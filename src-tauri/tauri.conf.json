{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elenchus Launcher",
  "version": "0.1.0",
  "identifier": "com.elenchus.launcher",
  "build": {
    "frontendDist": "../launcher"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Elenchus",
        "width": 640,
        "height": 520,
        "minWidth": 520,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../frontend/public/brand/elenchus.ico"
    ]
  }
}
