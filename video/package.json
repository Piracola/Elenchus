{
  "name": "elenchus-video-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ui": "tsx scripts/ui-server.mjs",
    "prepare:export": "tsx scripts/prepare-export.mjs",
    "studio": "remotion studio src/index.ts --props=public/data/render-props.json",
    "render": "remotion render src/index.ts DebateTranscript out/debate.mp4 --props=public/data/render-props.json",
    "still": "remotion still src/index.ts DebateTranscript out/frame.png --frame=120 --props=public/data/render-props.json",
    "fast-render": "tsx scripts/fast-render.mjs",
    "fast-frame": "tsx scripts/fast-render.mjs --frames-only"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@remotion/cli": "^4.0.484",
    "@remotion/media": "^4.0.484",
    "music-metadata": "^11.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.484",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3"
  }
}
